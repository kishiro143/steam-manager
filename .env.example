# Base de datos
DATABASE_URL=postgresql://usuario:password@localhost:5432/steam_db

# JWT — cambiar en producción con: openssl rand -hex 32
JWT_SECRET=cambia_esto_en_produccion
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# App
APP_ENV=development
APP_NAME=Steam Manager
APP_VERSION=1.0.0

# Admin por defecto (solo para seed inicial)
ADMIN_EMAIL=admin@steam.com
ADMIN_PASSWORD=Admin1234!

# Azure (solo producción)
AZURE_STORAGE_CONNECTION_STRING=
APPLICATIONINSIGHTS_CONNECTION_STRING=
